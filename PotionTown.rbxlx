	{
		Id = "ZenTeaHouse",
		DisplayName = "Zen Tea House",
		Emoji = "⛩️",
		Tagline = "Layered pagoda roof, paper windows and red lanterns.",
		Width = 34, Depth = 26, WallHeight = 12,
