	Roof.Type is one of: "Gable", "Flat", "Dome", "Cone", "Pagoda"
	Features are optional decorations, see HouseBuilder for what each does.
]]

local M = Enum.Material
local rgb = Color3.fromRGB

local HouseStyles = {}

