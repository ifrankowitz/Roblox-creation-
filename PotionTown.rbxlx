		Wall = { Color = rgb(125, 85, 52), Material = M.Wood },
		Trim = { Color = rgb(85, 55, 32), Material = M.Wood },
		Roof = { Type = "Gable", Color = rgb(70, 58, 48), Material = M.WoodPlanks, Height = 15 },
		Floor = { Color = rgb(110, 75, 45), Material = M.WoodPlanks },
