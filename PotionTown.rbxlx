}

HouseStyles.ById = {}
for index, style in ipairs(HouseStyles.List) do
	style.Order = index
	HouseStyles.ById[style.Id] = style
end

function HouseStyles.Get(id: string?)
	return (id and HouseStyles.ById[id]) or nil
end

return HouseStyles
]]></string>
